name: Build Signed Renault Docs APK

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Release preflight
        run: bash scripts/release-preflight.sh

      - name: Setup Java
        uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: '17'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4

      - name: Unit tests
        run: ./gradlew :app:testDebugUnitTest

      - name: Build signed release
        run: ./gradlew :app:assembleRelease

      # Before activating this workflow add:
      # - runtime keystore restoration from GitHub Secrets;
      # - apksigner verification;
      # - zipalign verification;
      # - aapt package/sdk check;
      # - SHA-256 generation;
      # - versioned artifact upload.
