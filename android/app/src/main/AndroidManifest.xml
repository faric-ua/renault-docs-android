<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- v0.5.150: install a checked update from the author's Google Drive (AppUpdateUi).
         Not for a Google Play build (see DRIVE_UPDATES in build.gradle.kts). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".RenaultDocsApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".ViewerActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize" />

        <activity
            android:name=".ModernDatasetActivity"
            android:exported="false"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".ModernVolumeActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize" />

        <activity
            android:name=".NativeSectionActivity"
            android:exported="false"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".VolumeDocumentationActivity"
            android:exported="false"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".DriveCatalogActivity"
            android:exported="false"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".ProjectChooserActivity"
            android:exported="false"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".CreateProjectActivity"
            android:exported="false"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".ProjectActivity"
            android:exported="false"
            android:screenOrientation="unspecified" />

        <!-- v0.5.132: import a whole project from one .rdproject file.
             Telegram, Google Drive and file managers do not know ".rdproject",
             so they send it as a generic file (octet-stream / zip). The screen
             reads only the beginning of the file and says plainly when it is
             not a Renault Docs project. -->
        <activity
            android:name=".RdprojectImportActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified">
            <!-- Phone QA 2026-10-14 23:01–23:04: another file manager lists Renault Docs
                 (it sends */*), but Samsung «Мої файли» offers only AndrOpen Office and
                 Mindomo — two ZIP readers. So «Мої файли» looks inside, sees a ZIP and
                 sends it as an archive, possibly as file:// and with a zip type name we
                 did not list. Both schemes and all common zip type names are accepted. -->
            <intent-filter android:label="@string/rdproject_import_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/zip-compressed" />
                <data android:mimeType="multipart/x-zip" />
                <data android:mimeType="application/x-rdproject" />
            </intent-filter>
            <!-- Phone QA 2026-10-14 20:13 (M30s, «Мої файли» → Download/Quick Share):
                 «Відкрити за допомогою» did not list Renault Docs for a .rdproject —
                 the file manager does not send octet-stream/zip for an unknown
                 extension. Match the file name ending instead. Android's pathPattern
                 is not a full regex: «.*\.rdproject» stops at the first dot, so one
                 pattern per number of dots in the path. -->
            <!-- Phone QA 2026-10-14 23:01 (M30s, v0.5.133): still not listed. The
                 name filter above required a MIME type (*/*) and a content:// address.
                 A filter with a mimeType never matches a request that carries no type
                 at all, and «Мої файли» may also send file://. So the name is matched
                 three ways: any type, no type, and file:// as well. A file:// address
                 that Android does not let us read is handled on the screen (pick the
                 file again). -->
            <intent-filter android:label="@string/rdproject_import_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.rdproject" />
                <data android:pathPattern=".*\\..*\\.rdproject" />
                <data android:pathPattern=".*\\..*\\..*\\.rdproject" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.rdproject" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.rdproject" />
            </intent-filter>
            <intent-filter android:label="@string/rdproject_import_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.rdproject" />
                <data android:pathPattern=".*\\..*\\.rdproject" />
                <data android:pathPattern=".*\\..*\\..*\\.rdproject" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.rdproject" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.rdproject" />
            </intent-filter>
            <intent-filter android:label="@string/rdproject_import_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/zip-compressed" />
                <data android:mimeType="multipart/x-zip" />
                <data android:mimeType="application/x-rdproject" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".CompletedNotificationDismissReceiver"
            android:exported="false" />

        <service
            android:name=".CatalogImportService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <service
            android:name=".RdpkgShareService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <service
            android:name=".ProjectFolderExportService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <service
            android:name=".RdprojectShareService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <service
            android:name=".RdprojectImportService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <service
            android:name=".RdpkgExportService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <service
            android:name=".RdpkgImportService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <service
            android:name=".VolumeTrashService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <service
            android:name=".NativeRdpkgPreparationService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name=".LocalDatasetDocumentsProvider"
            android:authorities="${applicationId}.datasets"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <activity
            android:name=".GuideActivity"
            android:exported="false"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
